  "story": [
    {
      "time": "2022",
      "title": "Gặp Nhau",
      "text": "Chúng mình vào cùng công ty từ năm 2022. Nhưng mãi đến nửa cuối năm 2023 mới thực sự biết đến nhau khi cùng diễn chung một tiết mục văn nghệ. Từ những buổi tập luyện, dần dần quen thân hơn, rồi nhắn tin qua lại... Lúc nào không hay, lại thích nhau mất rồi! 🌸"
    },
    {
      "time": "MÙA THU 2023",
      "title": "Lời Tỏ Tình",
      "text": "Một buổi tối mùa thu mát mẻ trước một cái hồ yên bình. Anh quay sang và nói: “Em làm người yêu anh nhé?”. Và em đã mỉm cười gật đầu. Từ khoảnh khắc ấy, chúng mình chính thức bước vào hành trình yêu thương cùng nhau. 💕"
    },
    {
      "time": "2024 – 2025",
      "title": "Những Ngày Yêu Nhau",
      "text": "Cùng nhau trải qua bao thăng trầm, vui buồn và thử thách. Dù bận rộn nhưng hai đứa luôn dành thời gian quan tâm, chăm sóc và thấu hiểu nhau nhiều hơn qua từng ngày."
    },
    {
      "time": "12/2025",
      "title": "Lời Cầu Hôn",
      "text": "Dưới ánh nến lung linh và khoảnh khắc xúc động ngập tràn, anh đã quỳ gối và trao chiếc nhẫn ước hẹn. Chúng mình biết rằng đã đến lúc cùng nhau xây đắp tổ ấm trọn đời. 💍"
    },
    {
      "time": "28.11.2026",
      "title": "Ngày Chung Đôi",
      "text": "Chính thức nên duyên vợ chồng trong sự chúc phúc của gia đình hai bên và bạn bè thân thương! Hân hạnh được đón tiếp Quý vị! 💒"
    }
  ],
